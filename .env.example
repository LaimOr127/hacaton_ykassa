PUBLIC_ORIGIN=http://127.0.0.1:8000
# simulated или live. Live требует оба ключа и использует внешний платёжный шлюз.
APP_MODE=simulated
# Указывайте только токен тестового магазина для прогона хакатона.
YOOKASSA_MCP_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Сгенерируйте случайный код от 24 символов для регистрации магазинов.
MERCHANT_SETUP_KEY=
# Fernet-ключ для хранения токенов магазинов. Требуется для подключения через кабинет в режиме live.
MERCHANT_VAULT_KEY=
# Отдельный код для первичного подключения кабинета существующей кофейни coffee.
COFFEE_OWNER_CODE=
