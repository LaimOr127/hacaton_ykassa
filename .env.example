PUBLIC_ORIGIN=http://127.0.0.1:8000
# simulated или live. Для live подключите модель и тестовый магазин в кабинете.
APP_MODE=simulated
# Указывайте только токен тестового магазина для прогона хакатона.
YOOKASSA_MCP_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Включить подключение модели через вход на OpenRouter.
OPENROUTER_OAUTH_ENABLED=0
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Включать после проверки доступности инструментов счетов для магазина.
MCP_INVOICES_ENABLED=0
# Сгенерируйте случайный код от 24 символов для регистрации магазинов.
MERCHANT_SETUP_KEY=
# Fernet-ключ для хранения токенов магазинов. Требуется для подключения через кабинет в режиме live.
MERCHANT_VAULT_KEY=
# Отдельный код для первичного подключения кабинета существующей кофейни coffee.
COFFEE_OWNER_CODE=

# Для закрытого запуска через compose.private.yaml укажите корпоративный OIDC.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=
OIDC_EMAIL_DOMAIN=
OIDC_MERCHANTS_JSON={}

# Часовые квоты и предел одновременных вызовов языковой модели.
MODEL_SESSION_LIMIT=25
MODEL_MERCHANT_LIMIT=60
MODEL_INSTANCE_LIMIT=120
MODEL_PARALLEL_LIMIT=8
