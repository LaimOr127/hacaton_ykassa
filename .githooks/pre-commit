#!/bin/sh
set -eu
git diff --cached --check
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$'; then
    echo 'Уберите файл с локальными секретами из коммита.' >&2
    exit 1
fi
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '^(app|tests)/.*\.py$'; then
    if [ -x .venv/Scripts/python.exe ]; then
        .venv/Scripts/python.exe -m ruff check app tests
    elif [ -x .venv/bin/python ]; then
        .venv/bin/python -m ruff check app tests
    else
        python -m ruff check app tests
    fi
fi
